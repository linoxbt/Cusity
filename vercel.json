{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run -w web build",
  "outputDirectory": "web/dist",
  "framework": null,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/(check|explain|cluster|audit|appeal|campaign|model|feature|stage|step)",
      "destination": "/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/(fonts|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/snapshot/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
